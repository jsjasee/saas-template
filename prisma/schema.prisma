// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id
  email            String    @unique
  isSubscribed     Boolean   @default(false)
  subscriptionEnds DateTime? // ? means it is optional
  todos            Todo[] // linking this up to another table, and can hold multiple of them. (foreign key idea)
}

model Todo {
  id        String   @id @default(cuid()) // EVERY table must have a unique id field
  title     String
  completed Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id]) // so this line means the type is User, and we are linking the userId field to be the id field in the User table? (relationship in classic SQL or prisma requires 2 FIELDS - what field am i expecting in my current table, i am storing the userId, and this userId is referenced from id of the User table - then why is there a user field and userId field?)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
